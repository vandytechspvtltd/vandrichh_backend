PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_change_this_in_production
ADMIN_JWT_SECRET=your_separate_admin_jwt_secret_key_change_this_in_production
# Optional first-start admin provisioning; configure both values in the deployment environment.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-strong-password
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
# Zoho should upload images to external storage and submit the resulting URL.
IMAGE_BASE_URL=https://cdn.example.com
